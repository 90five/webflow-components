    "@vitejs/plugin-react": "^5.0.3",
    "@webflow/data-types": "^1.0.1",
    "@webflow/react": "^1.0.1",
    "@webflow/webflow-cli": "^1.8.44",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
